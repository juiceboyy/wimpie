# Wimpie & de Domino's - Beheerders Dashboard Configuratie
# Vul deze waarden in op Netlify onder Site configuration > Environment variables
# of in een lokaal .env bestand voor lokaal testen.

# Geheime pincode of wachtwoord voor toegang tot het dashboard
ADMIN_PIN=kies-een-veilig-wachtwoord-of-pin

# GitHub Personal Access Token (met 'repo' of 'Contents: Read & Write' scope)
# Vereist voor het automatisch committen en publiceren vanaf de live Netlify site
GITHUB_TOKEN=ghp_jouw_github_persoonlijke_access_token

# GitHub repository (eigenaar/repo)
GITHUB_REPO=juiceboyy/wimpie

# Git branch waarop gebouwd en gepubliceerd wordt (standaard: main voor productie)
GITHUB_BRANCH=main
